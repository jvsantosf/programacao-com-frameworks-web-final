@baseUrl = http://localhost:3333/api
@token = cole-o-token-do-login-aqui

GET {{baseUrl}}/health

###

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Ana Lima",
  "email": "ana@email.com",
  "password": "123456"
}

###

POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "maria@locadora.com",
  "password": "123456"
}

###

GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

###

GET {{baseUrl}}/vehicles
Authorization: Bearer {{token}}

###

GET {{baseUrl}}/vehicles?available=true
Authorization: Bearer {{token}}

###

GET {{baseUrl}}/vehicles/1
Authorization: Bearer {{token}}

###

POST {{baseUrl}}/vehicles
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "brand": "Renault",
  "model": "Kwid",
  "year": 2024,
  "plate": "ABC1D23",
  "color": "Branco",
  "category": "ECONOMY",
  "dailyRate": 79.9
}

###

POST {{baseUrl}}/rentals
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "vehicleId": 1,
  "startDate": "2026-12-10T09:00:00-03:00",
  "expectedReturnDate": "2026-12-12T10:00:00-03:00"
}

###

GET {{baseUrl}}/rentals
Authorization: Bearer {{token}}

###

GET {{baseUrl}}/rentals?status=FINISHED
Authorization: Bearer {{token}}

###

GET {{baseUrl}}/rentals/1
Authorization: Bearer {{token}}

###

PATCH {{baseUrl}}/rentals/1/finish
Authorization: Bearer {{token}}
